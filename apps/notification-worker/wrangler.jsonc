{
  "name": "poruch-notification-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"]

  // Uncomment after creating resources:
  // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<same as API>" }],
  // "kv_namespaces": [{ "binding": "KV", "id": "<same as API>" }],
  // "queues": { "consumers": [{ "queue": "poruch-notifications", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 3, "dead_letter_queue": "poruch-notifications-dlq" }] }

  // Secrets (set via `wrangler secret put`):
  // TURBOSMS_TOKEN
  // TURBOSMS_SENDER
}
